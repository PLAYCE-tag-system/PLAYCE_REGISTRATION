REGISTRATION_API_BASE=http://127.0.0.1:4300
REGISTRATION_SITE_ID=suwon_01
REGISTRATION_READER_ID=rp_001
REGISTRATION_CLAIM_BASE_URL=khuround://tag-bindings/claim

# Raspberry Pi examples: /dev/ttyUSB0, /dev/ttyACM0
# Windows examples: COM8, 8
REGISTRATION_SERIAL_PORT=/dev/ttyUSB0
REGISTRATION_BAUDRATE=115200

# esp32: listen for TAG_DETECTED,EPC,RSSI text from the ESP32 sketch.
# direct: send UHF inventory command bytes from Python.
REGISTRATION_SOURCE_MODE=esp32
REGISTRATION_RESEND_INTERVAL_SECONDS=60
REGISTRATION_STARTUP_WAIT_SECONDS=2
REGISTRATION_COMMAND_RETRY_SECONDS=3
REGISTRATION_CLEAR_PENDING_ON_START=true
REGISTRATION_DEBUG=false
